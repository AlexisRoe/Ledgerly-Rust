root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4

# Vendored from Ledgerly-Java byte for byte (ADR 0007): editors must not reformat them.
[{vendor/**,api/**,bruno/**,redocly.yaml}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

{
  "realm": "ledgerly",
  "displayName": "Ledgerly",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "verifyEmail": false,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "ledgerly-web",
      "name": "Ledgerly web app (development)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "web-origins", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "ledgerly-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ledgerly-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "other-app",
      "name": "Some other application of the same realm (its tokens are not meant for Ledgerly)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["basic", "web-origins", "profile", "email", "roles"]
    }
  ],
  "users": [
    {
      "username": "alice@example.com",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }]
    },
    {
      "username": "bob@example.com",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": false,
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }]
    }
  ]
}

# Copy to .env (git-ignored) and fill in. Never commit real values.
# Added per milestone: database (M2), JWT keys (M5), object storage and ClamAV (M7).
SPRING_PROFILES_ACTIVE=local

# M5 - access token signing key (ES256 / P-256). Required outside the local and test profiles;
# there the app generates a throwaway key at startup.
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out jwt-private.pem
#   openssl ec -in jwt-private.pem -pubout -out jwt-public.pem
# Paste the PEM contents (newlines may be kept or replaced by \n).
LEDGERLY_AUTH_JWT_PRIVATE_KEY=
LEDGERLY_AUTH_JWT_PUBLIC_KEY=

# M7/M8 - object store (receipts and imports) and ClamAV. The defaults match compose.yaml (SeaweedFS on 8333,
# ClamAV on 3310); outside local development set all of them, with a private bucket and real credentials.
LEDGERLY_STORAGE_S3_ENDPOINT=http://localhost:8333
LEDGERLY_STORAGE_S3_REGION=us-east-1
LEDGERLY_STORAGE_S3_BUCKET=ledgerly-files
LEDGERLY_STORAGE_S3_ACCESS_KEY=
LEDGERLY_STORAGE_S3_SECRET_KEY=
LEDGERLY_RECEIPTS_CLAMAV_HOST=localhost
LEDGERLY_RECEIPTS_CLAMAV_PORT=3310

# M10 - browser access and limits.
# Browser origins allowed to call the API from JavaScript (CORS), comma-separated, exact origins only (a wildcard
# or a path stops the application from starting). Empty = no other site may read our responses.
LEDGERLY_SECURITY_ALLOWED_ORIGINS=
# Requests per minute: per signed-in user, and per client address for the endpoints that need no token.
# Behind a reverse proxy also set SERVER_FORWARD_HEADERS_STRATEGY=native so the address is the client's.
LEDGERLY_LIMITS_REQUESTS_PER_MINUTE=600
LEDGERLY_LIMITS_AUTH_REQUESTS_PER_MINUTE=60

# M11 - Keycloak instead of Ledgerly's own login (profile "keycloak"; see docs/deployment.md).
# SPRING_PROFILES_ACTIVE=prod,keycloak
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://id.example.com/realms/ledgerly

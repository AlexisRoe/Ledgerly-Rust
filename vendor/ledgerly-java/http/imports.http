### CSV imports and batch create. Run with SPRING_PROFILES_ACTIVE=local and `docker compose up`.

@host = http://localhost:8080/api/v1
@token = paste-access-token
@team = paste-team-id

### Upload a CSV (header: date,merchant,amount,currency,category[,note]; up to 10 MB / 10,000 rows)
# @name import
POST {{host}}/teams/{{team}}/imports
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=ledgerly

--ledgerly
Content-Disposition: form-data; name="file"; filename="expenses.csv"
Content-Type: text/csv

date,merchant,amount,currency,category,note
2026-11-01,Cafe Central,12.50,EUR,MEALS,Team lunch
2026-11-02,Deutsche Bahn,89.90,EUR,TRAVEL,
2026-11-03,Bad row,abc,EUR,MEALS,
--ledgerly--

###
@importId = {{import.response.body.id}}

### Progress and the list of skipped lines (the starter and OWNERs only)
GET {{host}}/teams/{{team}}/imports/{{importId}}
Authorization: Bearer {{token}}

### Create up to 100 drafts at once; partial success by default
POST {{host}}/teams/{{team}}/expenses:batch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    { "money": { "amount": "12.50", "currency": "EUR" }, "category": "MEALS", "incurredOn": "2026-11-05", "merchant": "Cafe" },
    { "money": { "amount": "12.345", "currency": "EUR" }, "category": "MEALS", "incurredOn": "2026-11-05", "merchant": "Too precise" }
  ]
}

### All-or-nothing: the bad item makes the whole batch a 422
POST {{host}}/teams/{{team}}/expenses:batch?atomic=true
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    { "money": { "amount": "12.50", "currency": "EUR" }, "category": "MEALS", "incurredOn": "2026-11-05", "merchant": "Cafe" },
    { "money": { "amount": "12.345", "currency": "EUR" }, "category": "MEALS", "incurredOn": "2026-11-05", "merchant": "Too precise" }
  ]
}

### Export the filtered list as CSV (formula cells are neutralised)
GET {{host}}/teams/{{team}}/expenses.csv?status=DRAFT&currency=EUR
Authorization: Bearer {{token}}

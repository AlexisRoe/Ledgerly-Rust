{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgerly-rust",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true
}
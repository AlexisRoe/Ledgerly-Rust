meta {
  name: create draft
  type: http
  seq: 1
}

post {
  url: {{host}}/teams/{{teamId}}/expenses
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

auth:bearer {
  token: {{carolToken}}
}

body:json {
  {
    "money": {
      "amount": "12.50",
      "currency": "EUR"
    },
    "category": "MEALS",
    "incurredOn": "2026-01-15",
    "merchant": "Bruno Cafe",
    "note": "Team lunch"
  }
}

script:post-response {
  bru.setVar("draftId", res.body.id);
  bru.setVar("draftEtag", res.headers["etag"]);
}

assert {
  res.status: eq 201
  res.body.status: eq DRAFT
  res.body.merchant: eq Bruno Cafe
}

tests {
  test("Location and ETag are set", function () {
    expect(res.headers["location"]).to.contain(res.body.id);
    expect(res.headers["etag"]).to.match(/^"\d+"$/);
  });
}

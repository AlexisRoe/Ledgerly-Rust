meta {
  name: create with a field the client may not set
  type: http
  seq: 4
}

post {
  url: {{host}}/teams/{{teamId}}/expenses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{carolToken}}
}

body:json {
  {
    "money": {
      "amount": "12.50",
      "currency": "EUR"
    },
    "category": "MEALS",
    "incurredOn": "2026-01-15",
    "merchant": "Bruno Cafe",
    "note": "Team lunch",
    "status": "APPROVED"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq MALFORMED_REQUEST
}

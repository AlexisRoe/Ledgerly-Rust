meta {
  name: login bob
  type: http
  seq: 2
}

post {
  url: {{host}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "bob@example.com",
    "password": "{{password}}"
  }
}

vars:post-response {
  bobToken: res.body.accessToken
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
}

tests {
  test("bob got an access token", function () {
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.expiresIn).to.be.above(0);
  });
}
